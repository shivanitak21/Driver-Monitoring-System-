EXPO_PUBLIC_TELEMETRY_URL=http://51.81.81.118:8000

# Leave empty. The phone app talks only to the guardian HTTP/WebSocket API.
EXPO_PUBLIC_MQTT_URL=

# Demo identifiers (optional overrides)
EXPO_PUBLIC_RIDE_ID=ride-1842
