# Guardian API (demo host). Leave empty only if you intentionally want the local simulation.
EXPO_PUBLIC_TELEMETRY_URL=http://51.81.81.118:8000

# Leave empty. The phone app talks only to the guardian HTTP/WebSocket API.
EXPO_PUBLIC_MQTT_URL=

# Demo identifiers (optional overrides)
EXPO_PUBLIC_RIDE_ID=ride-1842
EXPO_PUBLIC_DEVICE_ID=orin-nano-01

# Mapbox public access token (pk.*). Required for Live map on Android / Expo.
# Create one at https://account.mapbox.com/access-tokens/
# Do not commit .env — put your real token only in a local .env file.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=
